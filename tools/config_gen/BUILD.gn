template("generate_config") {
    not_needed(["invoker"])
    action("install_config_gen") {
        script = "install.js"
        args = []
        outputs = [target_out_dir]
    }
    action(target_name) {
        script = rebase_path("index.js")
        outdir = rebase_path(target_gen_dir)
        ohos_sdk_root = rebase_path("//interface/sdk-js")
        hms_sdk_root = rebase_path("//vendor/huawei/interface/hmscore_sdk_js")
        deps = [
            ":install_config_gen"
        ]
        args = [
            "-pkgName=ohos.ark_interop",
            "-outApi=${outdir}/apiConfig.cj",
            "-outKit=${outdir}/kitConfig.cj",
            "-sdkRoot=${ohos_sdk_root}",
            "-sdkRoot=${hms_sdk_root}"
        ]
        outputs = [
            "${target_gen_dir}/apiConfig.cj",
            "${target_gen_dir}/kitConfig.cj",
        ]
    }
}

generate_config("ark_interop_config") {
}